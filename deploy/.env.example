# Image tags are the first seven characters of each repository's commit SHA.
BACKEND_IMAGE=ghcr.io/linuxfestival/backend-v2
BACKEND_IMAGE_TAG=replace-with-backend-short-sha
FRONTEND_IMAGE=ghcr.io/linuxfestival/14th-linux-fest-frontend
FRONTEND_IMAGE_TAG=replace-with-frontend-short-sha

SITE_ADDRESS=linux-fest.ir
ACME_EMAIL=admin@linux-fest.ir

ALLOWED_HOSTS=linux-fest.ir,www.linux-fest.ir
CSRF_TRUSTED_ORIGINS=https://linux-fest.ir,https://www.linux-fest.ir
CORS_ALLOWED_ORIGINS=https://linux-fest.ir,https://www.linux-fest.ir
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

POSTGRES_DB=linuxfest
POSTGRES_USER=linuxfest
POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_ROOT_USER=linuxfest-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=linuxfest-media

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

SMS_KEY=
SMS_LINE_NUMBER=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=https://ceit-ssc.ir/payment/linuxfest/zarinpal/callback
PAYMENT_START_URL=https://ceit-ssc.ir/payment/start
PAYMENT_RETURN_URL=https://linuxfest.ceit-ssc.ir/payment/perhaps
PAYMENT_HTTP_CONNECT_TIMEOUT=5
PAYMENT_HTTP_READ_TIMEOUT=15
