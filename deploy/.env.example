# Image tags are the first seven characters of each repository's commit SHA.
BACKEND_IMAGE=ghcr.io/linuxfestival/backend-v2
BACKEND_IMAGE_TAG=replace-with-backend-short-sha
FRONTEND_IMAGE=ghcr.io/linuxfestival/14th-linux-fest-frontend
FRONTEND_IMAGE_TAG=replace-with-frontend-short-sha

SITE_ADDRESS=linuxfest.ir
ACME_EMAIL=admin@linuxfest.ir

ALLOWED_HOSTS=linuxfest.ir,www.linuxfest.ir
CSRF_TRUSTED_ORIGINS=https://linuxfest.ir,https://www.linuxfest.ir
CORS_ALLOWED_ORIGINS=https://linuxfest.ir,https://www.linuxfest.ir
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

POSTGRES_DB=linuxfest
POSTGRES_USER=linuxfest
POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_ROOT_USER=linuxfest-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=linuxfest-media

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

SMS_KEY=
SMS_LINE_NUMBER=
EMAIL_VERIFICATION_ENABLED=False
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=LinuxFest
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_TIMEOUT=10
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=https://ceit-ssc.ir/payment/linuxfest/zarinpal/callback
PAYMENT_START_URL=https://ceit-ssc.ir/payment/start
PAYMENT_RETURN_URL=https://linuxfest.ir/payment/perhaps
PAYMENT_HTTP_CONNECT_TIMEOUT=5
PAYMENT_HTTP_READ_TIMEOUT=15
