SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * root cd /root/linuxfest-deploy && /usr/bin/flock -n /run/lock/linuxfest-skyroom-email.lock /usr/bin/docker compose exec -T backend python manage.py send_skyroom_emails --limit 25 >> /var/log/linuxfest-skyroom-emails.log 2>&1
